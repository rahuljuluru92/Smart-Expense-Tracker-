# Copy to .env and fill in. The server refuses to start if required values are missing.
NODE_ENV=development
PORT=3001

# Required
DATABASE_URL=postgresql://expense_user:change-me@localhost:5433/expense_tracker
# Generate with: openssl rand -base64 48   (must be at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=1d

REDIS_URL=redis://localhost:6379

# CORS: the frontend origin. In production, localhost is NOT allowed automatically.
CLIENT_URL=http://localhost:3000
# Optional extra origins, comma-separated
CORS_ORIGINS=
# Optional regex for your own Vercel preview URLs (not every *.vercel.app site), e.g.
# CORS_PREVIEW_ORIGIN_REGEX=^https://smart-expense-tracker-[a-z0-9-]+-yourteam\.vercel\.app$
CORS_PREVIEW_ORIGIN_REGEX=

# Reverse proxies in front of the API (1 for Vercel/Railway/nginx, 0 when hit directly)
TRUST_PROXY=1
LOG_LEVEL=info
